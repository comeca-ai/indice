{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indicie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "CNPJ_DATA",
      "bucket_name": "indicie-cnpj"
    }
  ],
  "observability": {
    "enabled": true
  }
}
