{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indicie",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "vars": {
    "AI_GATEWAY_ID": "indicie",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "SESSION_SECRET": "troque-via-wrangler-secret-put-SESSION_SECRET"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/download/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "CNPJ_DATA",
      "bucket_name": "indicie-cnpj"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indicie-auth",
      "database_id": "65d8f3c3-9ef8-4039-b85d-4613e6c0d1ff",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
